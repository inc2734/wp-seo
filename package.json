{
	"engines": {
		"node": ">=24.22.1",
		"npm": ">=11.19.1"
	},
	"volta": {
		"node": "24.22.1"
	},
	"author": "inc2734",
	"license": "GPL-2.0+",
	"devDependencies": {
		"@wordpress/scripts": "^37.0.0",
		"@wordpress/env": "^12.0.0",
		"npm-run-all": "^4.1.5",
		"rimraf": "^6.0.1"
	},
	"scripts": {
		"wp-env": "wp-env",
		"start": "wp-env start",
		"stop": "wp-env stop",
		"destroy": "wp-env destroy && wp-env destroy --config=.wp-env.tests.json",
		"cli": "wp-env run cli --env-cwd=\"wp-content/plugins/wp-seo\"",
		"wp": "wp-env run cli --env-cwd=\"wp-content/plugins/wp-seo\" wp",
		"composer": "wp-env run --env-cwd=\"wp-content/plugins/wp-seo\" cli composer",
		"test:php:start": "wp-env start --config=.wp-env.tests.json",
		"test:php:stop": "wp-env stop --config=.wp-env.tests.json",
		"test-composer": "wp-env run cli --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-seo\" composer",
		"pretest:php:lint": "npm run test:php:start && npm run test-composer -- install --no-interaction",
		"test:php:lint": "wp-env run wordpress --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-seo\" composer run-script lint",
		"posttest:php:lint": "npm run test:php:stop",
		"pretest:php:unit": "npm run test:php:start && npm run test-composer -- install --no-interaction",
		"test:php:unit": "wp-env run wordpress --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-seo\" vendor/bin/phpunit -- -c .phpunit.xml.dist --verbose",
		"posttest:php:unit": "npm run test:php:stop",
		"test:lint:js": "wp-scripts lint-js src/src/js",
		"test:lint:php": "npm run test:php:lint || (test_status=$?; npm run test:php:stop; exit $test_status)",
		"test:lint": "run-s test:lint:js test:lint:php",
		"test:unit:php": "npm run test:php:unit || (test_status=$?; npm run test:php:stop; exit $test_status)",
		"test:unit": "npm run test:unit:php",
		"test": "run-s test:lint test:unit",
		"format:js": "wp-scripts format src/src/js",
		"format:php": "npm run wp-env start && npm run composer format",
		"format": "run-p format:*",
		"js:editor": "wp-scripts build src/src/js/editor.js --output-path src/dist/js",
		"js": "npm run clean:js && run-p js:*",
		"build": "npm run js",
		"clean:js": "rimraf src/dist/js"
	}
}
